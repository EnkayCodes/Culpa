# Copy to .env and fill in. .env is gitignored.

# Culpa consults Google Gemini. Get a free key (no card) at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model. Free-tier daily request caps are per-model:
#   gemini-2.5-flash-lite  ~1000/day  (default)
#   gemini-2.0-flash       ~200/day   (stronger on code)
#   gemini-2.5-flash       ~20/day    (avoid for real runs)
CULPA_MODEL=gemini-2.5-flash-lite
CULPA_MAX_TOKENS=16000

# Needed only for fork cases (an archive node)
MAINNET_RPC_URL=

# Sleuth knobs (these override config/preferences.yaml)
CULPA_MAX_LEADS=4
CULPA_MAX_PROOF_ATTEMPTS=2
CULPA_PROOF_TIMEOUT=180
