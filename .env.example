# Copy to .env and fill in. .env is gitignored.

# Marlowe consults Google Gemini. Get a free key (no card) at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id: gemini-2.5-flash (default) | gemini-2.0-flash | gemini-2.5-pro
MARLOWE_MODEL=gemini-2.5-flash
MARLOWE_MAX_TOKENS=8000

# Needed only for fork cases (an archive node)
MAINNET_RPC_URL=

# Sleuth knobs (these override config/preferences.yaml)
MARLOWE_MAX_LEADS=6
MARLOWE_MAX_PROOF_ATTEMPTS=3
MARLOWE_PROOF_TIMEOUT=180
