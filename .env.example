# Copy to .env and fill in. .env is gitignored.

# Culpa consults Google Gemini. Get a free key (no card) at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id: gemini-2.5-flash (default) | gemini-2.0-flash | gemini-2.5-pro
CULPA_MODEL=gemini-2.5-flash
CULPA_MAX_TOKENS=8000

# Needed only for fork cases (an archive node)
MAINNET_RPC_URL=

# Sleuth knobs (these override config/preferences.yaml)
CULPA_MAX_LEADS=6
CULPA_MAX_PROOF_ATTEMPTS=3
CULPA_PROOF_TIMEOUT=180
