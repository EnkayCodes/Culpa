# python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/

# env / secrets — everything .env* except the template
.env*
!.env.example

# foundry
proofground/out/
proofground/cache/
proofground/broadcast/
proofground/lib/

# gathered cases (keep the committed ones, drop the rest)
casework/contracts/*
!casework/contracts/HollowVault.sol
!casework/contracts/OpenTill.sol
!casework/contracts/Irongate.sol
!casework/contracts/LatchGate.sol
!casework/contracts/HallOfMirrors.sol
!casework/contracts/LooseLedger.sol
!casework/contracts/OriginGate.sol
!casework/contracts/GlassJaw.sol
!casework/contracts/FlashFarm.sol
!casework/contracts/TrueVault.sol
casework/proofs/*
!casework/proofs/HollowVault.t.sol
!casework/proofs/OpenTill.t.sol
!casework/proofs/HallOfMirrors.t.sol
!casework/proofs/LooseLedger.t.sol
!casework/proofs/OriginGate.t.sol
!casework/proofs/GlassJaw.t.sol
!casework/proofs/FlashFarm.t.sol

# run output — working runs are ignored; the canonical submission run lives in submission/
findings/*
!findings/.gitkeep
casebooks/*
!casebooks/.gitkeep
proofground/test/staged/*
!proofground/test/staged/.gitkeep

# submission/ is tracked in full — it holds the frozen run the judges review
!submission/
!submission/**
